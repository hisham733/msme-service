# Copy to .env (gitignored), fill in, then: docker compose up -d
# Never commit .env or paste its values anywhere.
TYPESAFE_API_KEY=
# DeepSeek key for receive/filter (or set it on /config after login).
DEEPSEEK_API_KEY=

# T-047 login. Bootstrap is used only while the users table is empty; remove both
# lines after the first sign-in and password change.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
# SESSION_DAYS=7
# COOKIE_SECURE=true   # false only for direct http://localhost
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
