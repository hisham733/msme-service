{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["NOW.md", ".claude/rules/msme-service.md"],
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "skill": "allow",
    "question": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "curl -s localhost*": "allow",
      "ls *": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "rm *": "deny"
    },
    "external_directory": "ask"
  }
}
