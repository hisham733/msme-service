{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["NOW.md", ".claude/rules/msme-service.md"],
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "skill": "allow",
    "question": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "curl -s localhost*": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "rsync *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "sqlite3 *": "allow",
      "docker build*": "allow",
      "docker run*": "allow",
      "docker compose*": "allow",
      "docker ps*": "allow",
      "docker logs*": "allow",
      "docker stop*": "allow",
      "docker rm*": "allow",
      "timeout 30 python3 *": "allow",
      "timeout 60 python3 *": "allow",
      "/tmp/opencode/*/bin/python *": "allow",
      "/tmp/opencode/*/bin/pip *": "allow",
      "/tmp/opencode/*/bin/ruff *": "allow",
      "git add*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "rm *": "deny"
    },
    "external_directory": "allow"
  }
}
